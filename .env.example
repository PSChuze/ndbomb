# Bomberman Online server settings. setup.py writes .env from this file; to set up by hand,
# copy it to .env and fill in the first block.

# --- needed ------------------------------------------------------------------------------
# This server's address as players reach it, as a dotted IP (the game takes no host name here,
# at most 15 characters): the LAN address for players at home, the public one otherwise.
BOMB_GAME_ADDR=
# The token an OpenLobby admin panel sends to the admin port (setup makes one).
BOMB_ADMIN_TOKEN=

# --- players at home and over the internet -----------------------------------------------
# Hand each player the address that works from their network, first match wins, e.g.
#   BOMB_ADVERTISE_MAP=192.168.0.0/16=192.168.0.10,0.0.0.0/0=203.0.113.5
# Empty: BOMB_GAME_ADDR for everyone. Docker Desktop (Windows, macOS) shows every player with
# one address, so leave it empty there.
BOMB_ADVERTISE_MAP=
# Matches link the consoles through the relay on TCP 10081, so no console needs an open port.
# 0 = consoles connect straight to the room host's TCP 10080 (only on one LAN).
BOMB_RELAY_PORT=10081
# The relay address handed to consoles; empty = the same as the lobby address.
BOMB_RELAY_HOST=

# --- Feega (sign-in) ----------------------------------------------------------------------
# The Feega account API on the openlobby Docker network (PSChuze/freega).
BOMB_FEEGA_URL=http://feega:24030
# Feega's FEEGA_API_TOKEN, when it has one.
BOMB_FEEGA_TOKEN=
# Seconds the list of feega-IDs is kept before it is asked again.
BOMB_FEEGA_CACHE=5

# --- the game ------------------------------------------------------------------------------
# 1 = new players register a nickname in the game. The registration screen posts to
# https://ps2bb-pkg03.bomberman-online.com/bombPersonal/db_write.asp (TLS 1.0 on port 443). Its
# certificate must be signed by the freega CA (add the pkg03 name to freega's FEEGA_TLS_NAMES and
# use freega's server certificate). This repository does not provide that TLS front, so leave it
# at 0 unless you run one in front of the web service. With 0, a player's feega-ID is their name.
BOMB_REQUIRE_NICKNAME=0
# The patch check's answers: the newest client version, and a nonzero status closes the
# server ("not in service").
BOMB_LATEST_CLIENT=10200
BOMB_SERVER_STATUS=0
# Ticket result byte: 0 = accepted.
BOMB_TICKET_RESULT=0

# --- support mail -------------------------------------------------------------------------
# A Discord channel webhook URL: each new support ticket is posted there. Empty = tickets are
# only kept (python -m bomb.support list, or an admin panel's inbox).
BOMB_SUPPORT_WEBHOOK=
# A chat bot that reads and answers tickets sends this in X-Support-Token, to
# http://bomb-web:24081/support/api/ on the openlobby Docker network. Empty = off.
BOMB_SUPPORT_API_TOKEN=

# --- folders and pairing ------------------------------------------------------------------
# The state folder (data and logs), relative to this folder.
BOMB_STATE=./state
# The secret an OpenLobby panel gave at pairing (setup keeps it).
OPENLOBBY_PAIRING=
